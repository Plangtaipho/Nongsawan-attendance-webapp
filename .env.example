# Copy to .env for local development. NEVER commit the real .env file.
ENV=development
DATABASE_URL=sqlite:///./dev.db
# Production example (MySQL-compatible managed DB):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/school_attendance
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
SECRET_KEY=change-me-to-a-long-random-string
SCHOOL_NAME=โรงเรียนตัวอย่าง
TIMEZONE=Asia/Bangkok
# Creates the first admin on startup when there are no users yet:
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=ผู้ดูแลระบบ
